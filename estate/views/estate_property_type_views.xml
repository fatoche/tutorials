<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_type_view_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_type_view_list" model="ir.ui.view">
        <field name="name">Estate property type list view</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Property Types">
                <field name="name"/>
                <field name="offer_count"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="estate_property_type_view_from" model="ir.ui.view">
        <field name="name">Property Types Form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <button
                        name="%(action_open_related_offers)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-money"
                    >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="offer_count"/>
                            </span>
                            <span class="o_stat_text"> Offers</span>
                        </div>
                    </button>
                    <h1><field name="name" placeholder="Enter type"/></h1>
                    <notebook>
                        <page string="Properties">
                            <field name="property_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="expected_price"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>